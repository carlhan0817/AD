{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": ["node"],
    "outDir": "dist",
    "paths": {
      "@ad/core/*": ["../core/src/*"]
    }
  },
  "include": ["src", "tests"]
}
