{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "jsx": "react-jsx",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["node"],
    "outDir": "out",
    "paths": {
      "@ad/core/*": ["../core/src/*"],
      "@ad/shared/*": ["../shared/*"],
      "@ad/renderer/*": ["../renderer/src/*"]
    }
  },
  "include": ["src", "tests"]
}
